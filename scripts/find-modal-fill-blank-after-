import { loadAllLessons } from './src/data/daily/index'

const verbs = new Set([
  'play', 'speak', 'swim', 'run', 'walk', 'fly', 'read', 'write', 'cook', 'drive', 'sing', 'dance',
  'study', 'work', 'help', 'open', 'use', 'sit', 'come', 'go', 'eat', 'drink', 'sleep', 'see', 'watch',
  'listen', 'learn', 'teach', 'buy', 'sell', 'make', 'do', 'have', 'take', 'give', 'get', 'meet',
  'like', 'love', 'want', 'need', 'know', 'think', 'feel', 'live', 'call', 'pay', 'wear', 'find',
  'leave', 'stay', 'move', 'travel', 'visit', 'answer', 'ask', 'clean', 'close', 'start', 'stop',
  'remember', 'forget', 'understand', 'explain', 'describe', 'choose', 'bring', 'send', 'keep', 'turn'
])

function normalize(s: string) {
  return s.toLowerCase().replace(/[‘’ʼ]/g, "'").replace(/[^\w']/g, ' ').replace(/\s+/g, ' ').trim()
}

async function main() {
  const lessons = await loadAllLessons()
  for (const lesson of lessons) {
    const exercises = [
      ...lesson.exercises,
      ...(lesson.specialCases?.flatMap(sc => sc.drills) ?? []),
      ...lesson.tests,
    ]
    for (const ex of exercises) {
      if (ex.type !== 'fill-blank') continue
      const blanks = (ex.blanks ?? []).map(normalize)
      if (blanks.length === 0) continue
      const parts = ex.question.split(/_{3,}/).map(normalize).filter(Boolean)
      for (let i = 0; i < blanks.length; i++) {
        const after = parts[i + 1]
        if (!after) continue
        const firstAfter = after.split(/\s+/)[0]
        if (verbs.has(firstAfter) && blanks[i].length <= 3) {
          console.log(`${lesson.id}:${ex.id} | ${ex.question} | blanks=[${ex.blanks.join(', ')}] | after="${firstAfter}"`)
        }
      }
    }
  }
}

main()
